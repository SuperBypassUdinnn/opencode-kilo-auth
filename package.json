{
  "name": "opencode-kilo-auth",
  "version": "2.0.0",
  "description": "OpenCode V2 plugin for Kilo Gateway - multi-account rotation, device OAuth, API key auth",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "SuperBypassUdinnn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperBypassUdinnn/opencode-kilo-auth.git"
  },
  "homepage": "https://github.com/SuperBypassUdinnn/opencode-kilo-auth#readme",
  "bugs": {
    "url": "https://github.com/SuperBypassUdinnn/opencode-kilo-auth/issues"
  },
  "keywords": [
    "opencode",
    "kilo",
    "gateway",
    "ai",
    "llm",
    "plugin",
    "free-models",
    "openrouter",
    "claude",
    "gpt",
    "gemini"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "fetch-models": "npx tsx scripts/fetch-models.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@opencode/plugin": "^2.2.1",
    "zod": "^3.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.0.0"
  }
